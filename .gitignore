# Local build outputs
/marshal
/webbridge
/bin/
# the Studio's web build (flutter build web --output ../share/marshal/studio)
/share/
# GoReleaser build output
/dist/

# Node dependencies, wherever they appear: a `node_modules` is always vendored
# code, never hand-written source, so the unanchored form is the right one.
node_modules/

# The retired Svelte Studio. The Flutter app in app/ replaced it (F8), and all
# that is left here is the `node_modules` tree above; nothing under web/ui is
# tracked.
web/ui/

# Go test/build artifacts
*.test
*.out
coverage.txt
coverage.html
# Local multi-module overrides; this repo builds from go.mod alone.
go.work
go.work.sum

# Editor and OS files
.DS_Store
.idea/

# Agent workflow scratch
.agents/
.superpowers/
.worktrees/
/main/
.agent/
.claude/
.kilo/
.opencode/
.workpowers/

# Local project state and database; the project config is machine-local
# and is no longer committed (providers/presets live in the user-global
# config). See .marshal/.gitignore for the rest of .marshal/'s contents.
# This repo's hand-authored project skills are the exception: they are
# tracked so they are versioned and reviewed (see marshal-skill-authoring).
.marshal/*
!.marshal/.gitignore
!.marshal/skills/

# Relocated Go home (module cache, build cache, telemetry)
/.home/

# Documentation archive and workflow artifacts
.docs-archive/
docs/superpowers/
docs/specs/
skills-lock.json
# Logo/mockup scratch: mockup HTML, PNG variants and the python checkers that
# measure them. Local working material, not published docs.
docs/logo/

# Saved diffs / patch scratch from agent workflows
*.diff
*.patch

# Generated session exports
/marshal-session-*.html

# Python bytecode from the E2E harness
__pycache__/
*.pyc

# The fvm SDK cache, and the pin beside it: `.fvmrc` records the SDK a machine
# chose, which is per-machine state, not a repo decision. scripts/dev-daemon.sh
# reads it when present and falls back to `fvm flutter` when it is absent.
.fvm/
.fvmrc

# Local secrets, never committed. `kimi-api` holds API keys and `api.fish` is a
# fish script that exports one as an environment variable. Both stay unanchored
# on purpose: a key file is not safe to commit wherever it is dropped, so the
# rule follows the name to any directory.
kimi-api
api.fish
