// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name: the bundle is Marshal.app, and CFBundleName is what
// the menu bar and the Finder call it.
PRODUCT_NAME = Marshal

// The executable inside the bundle keeps the project's name, so an install
// never puts anything called `marshal` in the bundle's place on PATH. The
// daemon's own binary stays the one thing named `marshal`.
EXECUTABLE_NAME = marshal_app

// The application's bundle identifier. Not the daemon's, which is a command
// line program: dev.marshal.app names the GUI, and the login item that
// `launch_at_startup` registers is this bundle.
PRODUCT_BUNDLE_IDENTIFIER = dev.marshal.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 dev.marshal. All rights reserved.
