{
  "EnvWorkspace": {
    "name": "go-service",
    "base": "ubuntu:24.04",
    "toolchains": ["go@1.24", "node@22"]
  },
  "EnvPackages": {
    "apt": ["jq"],
    "go": ["golang.org/x/tools/gopls@latest"]
  },
  "EnvMount": {
    "volume": "gomodcache",
    "target": "/go/pkg/mod"
  },
  "EnvFile": {
    "target": "/home/agent/.gitconfig",
    "readonly": true
  },
  "EnvInject": {
    "ref": "vault:forge/github-token",
    "header": "Authorization",
    "format": "Bearer {value}"
  },
  "EnvNetwork": {
    "mode": "allowlist",
    "egress": ["proxy.golang.org", "*.github.com"]
  },
  "EnvResources": {
    "cpu": 2,
    "memory": "4g",
    "disk": "20g",
    "timeout": "30m"
  },
  "EnvPolicy": {
    "mode": "restricted",
    "auto": true,
    "allow": ["file.read"]
  },
  "EnvSetup": {
    "run": "go mod download"
  },
  "EnvPreview": {
    "ports": [8080]
  },
  "EnvDoc": {
